# Secret file of the simulated edge device (profile "edge-sim"). It is written on the host by a
# registration script (poc/dev/edge-sim-register.sh of the master's thesis repository) and never
# committed: EDGE_ID and EDGE_KEY together allow anyone to register as this device with Portainer.
# In production the file lives in /opt/agri-gaia/secrets/ and is copied here by the deployment.
EDGE_ID=
EDGE_KEY=
