# Secrets of the agent gateway (orchestrator). Copy to secrets/agent-gateway.env; never commit.
# In production the file lives in /opt/agri-gaia/secrets/ and is copied here by the deployment.

# Model provider key; stays with the orchestrator, never reaches a sandbox.
DEEPSEEK_API_KEY=

# Client secret of the Keycloak client agw-agent (login and token exchange).
AGW_PLATFORM_CLIENT_SECRET=

# Database and object store of the gateway; same values as in agent-gateway-services.env.
AGW_DATABASE_URL=postgres://agwpoc:<POSTGRES_PASSWORD>@agent_postgres:5432/agwpoc?sslmode=disable
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
